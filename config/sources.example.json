{
  "sources": [
    {
      "name": "aliyun-pricing",
      "mode": "pricing",
      "scope": "domestic",
      "provider": "阿里云",
      "endpoint": "https://YOUR_TRUSTED_ALIYUN_MCP_ENDPOINT/mcp",
      "tool": "list_model_prices",
      "api_key_env": "ALIYUN_MCP_TOKEN",
      "arguments": {
        "region": "cn-hangzhou",
        "currency": "CNY",
        "unit": "CNY/1M tokens"
      },
      "enabled": false
    },
    {
      "name": "deepseek-pricing",
      "mode": "pricing",
      "scope": "domestic",
      "provider": "DeepSeek",
      "endpoint": "https://YOUR_TRUSTED_DEEPSEEK_MCP_ENDPOINT/mcp",
      "tool": "list_model_prices",
      "api_key_env": "DEEPSEEK_MCP_TOKEN",
      "arguments": {
        "currency": "CNY",
        "unit": "CNY/1M tokens"
      },
      "enabled": false
    },
    {
      "name": "tavily-market-research",
      "mode": "discovery",
      "scope": "all",
      "category": "news",
      "query_argument": "query",
      "query_templates": {
        "pricing": "{provider} {aliases} official API pricing input output token price {domains}",
        "model_news": "{provider} {aliases} new AI model release announcement {domains}",
        "market_news": "AI large language model pricing launch news trending {watch_terms} {region} {date}",
        "model_verification": "\"{model}\" {provider} official API pricing description strengths context window {domains}"
      },
      "endpoint": "https://api.tavily.com/search",
      "tool": "tavily_search",
      "api_key_env": "TAVILY_API_KEY",
      "auth_header": "Authorization",
      "auth_scheme": "Bearer",
      "arguments": {
        "search_depth": "basic",
        "max_results": 5,
        "include_answer": false,
        "include_raw_content": false,
        "include_published_date": true
      },
      "transport": "tavily",
      "max_model_queries": 100,
      "watch_terms": [
        "牛来",
        "Ox Alpha"
      ],
      "enabled": true
    }
  ],
  "targets": [
    {
      "provider": "阿里云",
      "region": "domestic",
