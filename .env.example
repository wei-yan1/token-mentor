# Replace with a random secret of at least 32 characters. Never commit the actual value.
TOKEN_MENTOR_API_KEY=
TOKEN_MENTOR_DB=/data/catalog.sqlite3
ALIYUN_MCP_TOKEN=
DEEPSEEK_MCP_TOKEN=
TAVILY_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
TOKEN_MENTOR_DECISION_BACKEND=laya
TOKEN_MENTOR_LAYA_MODEL=convaiinnovations/laya-multilingual
TOKEN_MENTOR_LAYA_DEVICE=auto

# Internal catalog/workflow access; must differ from customer API key. Empty disables access.
TOKEN_MENTOR_OPERATOR_KEY=
# Browser sessions are Secure automatically under HTTPS. Set true behind a TLS proxy if needed.
TOKEN_MENTOR_COOKIE_SECURE=false

# QQ mailbox SMTP (turn on SMTP in QQ Mail settings and use its generated authorization code).
TOKEN_MENTOR_SMTP_HOST=smtp.qq.com
TOKEN_MENTOR_SMTP_PORT=465
TOKEN_MENTOR_SMTP_USERNAME=your-qq-address@qq.com
TOKEN_MENTOR_SMTP_PASSWORD=

# Disabled by default. Compatibility key bypasses credit charging; keep false in paid services.
TOKEN_MENTOR_ALLOW_LEGACY_KEY=false
# Example offer: CNY 10.00 for 10 recommendation requests. Existing orders keep their original price.
TOKEN_MENTOR_PACK_AMOUNT_FEN=1000
TOKEN_MENTOR_PACK_CREDITS=10

# Official Alipay SDK, RSA2 public-key mode. Sandbox and production use separate databases.
ALIPAY_SANDBOX=true
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_NOTIFY_URL=
# Local CLI: absolute PEM paths. Docker: mounts secrets/alipay under /run/alipay.
ALIPAY_PRIVATE_KEY_FILE=
ALIPAY_PUBLIC_KEY_FILE=
